generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin {
  id          Int      @id @default(autoincrement())
  nama        String   @db.VarChar(120)
  email       String   @unique @db.VarChar(191)
  kata_sandi  String   @db.VarChar(255)
  peran       String   @default("admin") @db.VarChar(40)
  dibuat_pada DateTime @default(now())
}

model kategori {
  id            Int           @id @default(autoincrement())
  nama_kategori String        @db.VarChar(120)
  slug          String        @unique @db.VarChar(191)
  ikon_url      String?       @db.VarChar(500)
  dibuat_pada   DateTime      @default(now())
  produk        produk[]
  subkategori   subkategori[]
}

model subkategori {
  id               Int      @id @default(autoincrement())
  kategori_id      Int
  nama_subkategori String   @db.VarChar(120)
  slug             String   @db.VarChar(191)
  dibuat_pada      DateTime @default(now())
  produk           produk[]
  kategori         kategori @relation(fields: [kategori_id], references: [id], onDelete: Restrict)

  @@unique([kategori_id, slug])
  @@index([kategori_id])
}

model produk {
  id                      Int                       @id @default(autoincrement())
  kategori_id             Int?
  subkategori_id          Int?
  kode_produk             String                    @unique @db.VarChar(80)
  nama_produk             String                    @db.VarChar(191)
  slug                    String                    @unique @db.VarChar(191)
  deskripsi               String                    @db.Text
  informasi_gizi          Json
  jenis_harga             String                    @default("tetap") @db.VarChar(20)
  harga                   Decimal?                  @db.Decimal(12, 2)
  harga_min               Decimal?                  @db.Decimal(12, 2)
  harga_max               Decimal?                  @db.Decimal(12, 2)
  stok                    Int?                      @db.UnsignedInt
  satuan                  String                    @default("porsi") @db.VarChar(40)
  foto_url                String?                   @db.Text
  tersedia                Boolean                   @default(true)
  dibuat_pada             DateTime                  @default(now())
  diperbarui_pada         DateTime                  @updatedAt
  kategori                kategori?                 @relation(fields: [kategori_id], references: [id], onDelete: SetNull)
  subkategori             subkategori?              @relation(fields: [subkategori_id], references: [id], onDelete: SetNull)
  detail_pesanan          detail_pesanan[]
  riwayat_perubahan_harga riwayat_perubahan_harga[]
  pencarian_gambar        pencarian_gambar_produk?
  kandidat_gambar         kandidat_gambar_produk[]

  @@index([kategori_id])
  @@index([subkategori_id])
  @@index([tersedia])
}

model pencarian_gambar_produk {
  id              Int       @id @default(autoincrement())
  produk_id       Int       @unique
  status          String    @default("belum_dicari") @db.VarChar(30)
  query           String?   @db.VarChar(500)
  jumlah_request  Int       @default(0)
  percobaan       Int       @default(0)
  error_terakhir  String?   @db.Text
  dicari_pada     DateTime?
  dipilih_pada    DateTime?
  diperbarui_pada DateTime  @updatedAt
  produk          produk    @relation(fields: [produk_id], references: [id], onDelete: Cascade)

  @@index([status])
}

model kandidat_gambar_produk {
  id            Int      @id @default(autoincrement())
  produk_id     Int
  posisi        Int
  judul         String?  @db.VarChar(500)
  image_url     String   @db.Text
  thumbnail_url String?  @db.Text
  source_url    String?  @db.Text
  domain        String?  @db.VarChar(191)
  provider      String   @default("serpapi") @db.VarChar(40)
  relevansi     Int      @default(0)
  dipilih       Boolean  @default(false)
  dibuat_pada   DateTime @default(now())
  produk        produk   @relation(fields: [produk_id], references: [id], onDelete: Cascade)

  @@unique([produk_id, posisi])
  @@index([produk_id])
  @@index([dipilih])
}

model rekap_barang {
  id            Int    @id @default(autoincrement())
  kategori      String @db.VarChar(120)
  subkategori   String @db.VarChar(120)
  jumlah_barang Int

  @@unique([kategori, subkategori])
  @@index([kategori])
}

model pengaturan_katalog {
  id              Int      @id @default(autoincrement())
  nama_instansi   String   @db.VarChar(191)
  logo_url        String?  @db.VarChar(500)
  nomor_whatsapp  String   @db.VarChar(30)
  alamat          String?  @db.Text
  email           String?  @db.VarChar(191)
  hak_cipta       String   @default("© 2026 PT DapurKita Solusi Kuliner Internasional. Hak Cipta Dilindungi Undang-Undang.") @db.VarChar(500)
  template_pesan  String   @db.Text
  diperbarui_pada DateTime @updatedAt
}

model slider_beranda {
  id          Int      @id @default(autoincrement())
  foto_url    String   @db.VarChar(500)
  urutan      Int      @default(0)
  dibuat_pada DateTime @default(now())

  @@index([urutan])
}

model riwayat_pesanan {
  id                Int              @id @default(autoincrement())
  kode_pesanan      String           @unique @db.VarChar(40)
  nama_pemesan      String           @db.VarChar(160)
  nama_sekolah      String?          @db.VarChar(191)
  telepon_pemesan   String?          @db.VarChar(30)
  catatan           String?          @db.Text
  total_harga       Decimal          @db.Decimal(12, 2)
  total_harga_max   Decimal?         @db.Decimal(12, 2)
  status_pesanan    String           @default("menunggu_konfirmasi") @db.VarChar(40)
  status_pembayaran String           @default("belum_dibayar") @db.VarChar(40)
  dibuat_pada       DateTime         @default(now())
  detail_pesanan    detail_pesanan[]

  @@index([dibuat_pada])
  @@index([status_pesanan])
  @@index([status_pembayaran])
}

model detail_pesanan {
  id               Int             @id @default(autoincrement())
  pesanan_id       Int
  produk_id        Int?
  nama_produk      String          @db.VarChar(191)
  harga_satuan     Decimal         @db.Decimal(12, 2)
  harga_satuan_max Decimal?        @db.Decimal(12, 2)
  jumlah           Int
  subtotal         Decimal         @db.Decimal(12, 2)
  subtotal_max     Decimal?        @db.Decimal(12, 2)
  pesanan          riwayat_pesanan @relation(fields: [pesanan_id], references: [id], onDelete: Cascade)
  produk           produk?         @relation(fields: [produk_id], references: [id], onDelete: SetNull)

  @@index([pesanan_id])
  @@index([produk_id])
}

model riwayat_perubahan_harga {
  id               Int      @id @default(autoincrement())
  produk_id        Int?
  kode_produk      String   @db.VarChar(80)
  nama_produk      String   @db.VarChar(191)
  jenis_harga_lama String   @db.VarChar(20)
  harga_lama       Decimal? @db.Decimal(12, 2)
  harga_min_lama   Decimal? @db.Decimal(12, 2)
  harga_max_lama   Decimal? @db.Decimal(12, 2)
  jenis_harga_baru String   @db.VarChar(20)
  harga_baru       Decimal? @db.Decimal(12, 2)
  harga_min_baru   Decimal? @db.Decimal(12, 2)
  harga_max_baru   Decimal? @db.Decimal(12, 2)
  diubah_pada      DateTime @default(now())
  produk           produk?  @relation(fields: [produk_id], references: [id], onDelete: SetNull)

  @@index([diubah_pada])
  @@index([kode_produk])
  @@index([produk_id, diubah_pada])
}
